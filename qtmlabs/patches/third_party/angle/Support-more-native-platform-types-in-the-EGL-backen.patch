From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: msizanoen <msizanoen@qtmlabs.xyz>
Date: Wed, 30 Aug 2023 06:56:29 +0200
Subject: Support more native platform types in the EGL backend

This allows applications to use the GBM, Wayland and X11 native platform
types with ANGLE's EGL display backend.

diff --git a/src/libANGLE/renderer/gl/egl/DisplayEGL.cpp b/src/libANGLE/renderer/gl/egl/DisplayEGL.cpp
index fb0ae8249db0e433014f98e8688d5bd6e5fb14c3..b5f14e39f1ec32133bbc95d6b26d5395d941b5ae 100644
--- a/src/libANGLE/renderer/gl/egl/DisplayEGL.cpp
+++ b/src/libANGLE/renderer/gl/egl/DisplayEGL.cpp
@@ -996,6 +996,27 @@ RendererGL *DisplayEGL::getRenderer() const
     return mRenderer.get();
 }
 
+bool DisplayEGL::isX11() const
+{
+    EGLAttrib platformType =
+        mDisplayAttributes.get(EGL_PLATFORM_ANGLE_NATIVE_PLATFORM_TYPE_ANGLE, 0);
+    return platformType == EGL_PLATFORM_X11_EXT || platformType == EGL_PLATFORM_XCB_EXT;
+}
+
+bool DisplayEGL::isWayland() const
+{
+    EGLAttrib platformType =
+        mDisplayAttributes.get(EGL_PLATFORM_ANGLE_NATIVE_PLATFORM_TYPE_ANGLE, 0);
+    return platformType == EGL_PLATFORM_WAYLAND_EXT;
+}
+
+bool DisplayEGL::isGBM() const
+{
+    EGLAttrib platformType =
+        mDisplayAttributes.get(EGL_PLATFORM_ANGLE_NATIVE_PLATFORM_TYPE_ANGLE, 0);
+    return platformType == EGL_PLATFORM_GBM_MESA;
+}
+
 egl::Error DisplayEGL::validateImageClientBuffer(const gl::Context *context,
                                                  EGLenum target,
                                                  EGLClientBuffer clientBuffer,
diff --git a/src/libANGLE/renderer/gl/egl/DisplayEGL.h b/src/libANGLE/renderer/gl/egl/DisplayEGL.h
index eee714ce4da6913c7f24659b6b5ab3ae50db9a50..4e8067b942a5d635b1255458c7ca67d69423b496 100644
--- a/src/libANGLE/renderer/gl/egl/DisplayEGL.h
+++ b/src/libANGLE/renderer/gl/egl/DisplayEGL.h
@@ -89,6 +89,10 @@ class DisplayEGL : public DisplayGL
 
     RendererGL *getRenderer() const override;
 
+    bool isX11() const override;
+    bool isWayland() const override;
+    bool isGBM() const override;
+
     egl::Error validateImageClientBuffer(const gl::Context *context,
                                          EGLenum target,
                                          EGLClientBuffer clientBuffer,
diff --git a/src/libANGLE/renderer/gl/egl/FunctionsEGL.cpp b/src/libANGLE/renderer/gl/egl/FunctionsEGL.cpp
index 65a440166494cb922360e259e986f239b22d07b7..c4e267a58248eb3fbca55feed8c93edcd7cdefa0 100644
--- a/src/libANGLE/renderer/gl/egl/FunctionsEGL.cpp
+++ b/src/libANGLE/renderer/gl/egl/FunctionsEGL.cpp
@@ -36,7 +36,11 @@ bool IsValidPlatformTypeForPlatformDisplayConnection(EGLAttrib platformType)
 {
     switch (platformType)
     {
+        case EGL_PLATFORM_GBM_MESA:
         case EGL_PLATFORM_SURFACELESS_MESA:
+        case EGL_PLATFORM_WAYLAND_EXT:
+        case EGL_PLATFORM_X11_EXT:
+        case EGL_PLATFORM_XCB_EXT:
             return true;
         default:
             break;
@@ -417,10 +421,26 @@ EGLDisplay FunctionsEGL::getPlatformDisplay(EGLAttrib platformType,
     ASSERT(IsValidPlatformTypeForPlatformDisplayConnection(platformType));
     switch (platformType)
     {
+        case EGL_PLATFORM_GBM_MESA:
+            if (!hasExtension("EGL_MESA_platform_gbm"))
+                return EGL_NO_DISPLAY;
+            break;
         case EGL_PLATFORM_SURFACELESS_MESA:
             if (!hasExtension("EGL_MESA_platform_surfaceless"))
                 return EGL_NO_DISPLAY;
             break;
+        case EGL_PLATFORM_WAYLAND_EXT:
+            if (!hasExtension("EGL_EXT_platform_wayland"))
+                return EGL_NO_DISPLAY;
+            break;
+        case EGL_PLATFORM_X11_EXT:
+            if (!hasExtension("EGL_EXT_platform_x11"))
+                return EGL_NO_DISPLAY;
+            break;
+        case EGL_PLATFORM_XCB_EXT:
+            if (!hasExtension("EGL_EXT_platform_xcb"))
+                return EGL_NO_DISPLAY;
+            break;
         default:
             UNREACHABLE();
             return EGL_NO_DISPLAY;
