-EGLDeviceEXT FunctionsEGL::getPreferredEGLDevice(const std::vector<EGLDeviceEXT> &devices)
-{
-    // Only called after confirming we have the necessary extension.
-    PFNEGLQUERYDEVICESTRINGEXTPROC queryDeviceStringEXTPtr;
